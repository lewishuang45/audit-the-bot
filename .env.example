# Optional local Node demo persistence. Vercel demo mode uses browser storage
# plus ephemeral serverless storage unless a real backend is added later.
SUBMISSION_STORE_PATH="./data/audit-the-bot-submissions.json"

# Optional live Gemini revision agent. Leave ATB_LIVE_AI unset/false for mock mode.
ATB_LIVE_AI=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=20000
ATB_LIVE_DAILY_LIMIT=50
ATB_LIVE_MINUTE_LIMIT=5

# Other future provider placeholders only.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
